<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
        android:fillViewport="true">  <!-- Ensures content takes up full screen -->
    <LinearLayout
        android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="0dp">

        <!-- Blank Row with Plus Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#1E3F67"
            android:textSize="20sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">


            <TextView
                android:id="@+id/alarmLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:textSize="24sp"
                android:text="New:"
                android:textColor="#ECEFF1"
                android:textStyle="bold" />


            <Button
                android:id="@+id/addAlarmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textSize="24sp"
                android:textStyle="bold"/>

        </FrameLayout>
        <!-- TextView to Display Selected Time -->
<!--        <TextView-->
<!--            android:id="@+id/alarmTextView"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Test123Alarmz"-->
<!--            android:textSize="18sp"-->
<!--            android:gravity="center"-->
<!--            android:padding="16dp"/>-->
        <!-- Container for dynamically added alarms -->

        <LinearLayout
            android:id="@+id/alarmsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"/>

        <TextView
            android:id="@+id/msgNextAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:textAlignment="center"
            android:textSize="20sp"
            android:text="Next alarm @"
            />
        <!-- app:layout_constraintBottom_toBottomOf="parent" -->
        <!-- app:layout_constraintEnd_toEndOf="parent" -->
        <!-- app:layout_constraintStart_toStartOf="parent" -->
        <!-- app:layout_constraintTop_toTopOf="parent" -->
    </LinearLayout>
</ScrollView>
